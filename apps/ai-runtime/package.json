{
  "name": "@pm/ai-runtime",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.json",
    "sync:qa-skill": "bun scripts/sync-qa-test-case-skill.mjs",
    "sync:skills": "bun scripts/sync-skills.mjs",
    "changelog:draft": "bun scripts/changelog-draft.ts",
    "release-notes:auto": "bun scripts/release-notes-auto.ts",
    "benchmark:qa-complex": "bun scripts/benchmark-qa-complex.mjs",
    "start": "bun dist/server.js",
    "test": "bun test --parallel",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.25",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^7.0.55",
    "fastify": "^5.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
