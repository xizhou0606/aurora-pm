    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "crossws": "0.4.12",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^22.10.0",
    "typescript": "7.0.2"
