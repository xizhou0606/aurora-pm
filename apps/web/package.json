{
  "name": "@pm/web",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "dev": "bun node_modules/@rsbuild/core/bin/rsbuild.js dev --config rsbuild.config.ts",
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.json && bun node_modules/@rsbuild/core/bin/rsbuild.js build --config rsbuild.config.ts",
    "check:bundle": "bun scripts/check-bundle.mjs",
    "check:takeover": "bun scripts/check-takeover.mjs",
    "lint": "oxlint src",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json",
    "preview": "bun node_modules/@rsbuild/core/bin/rsbuild.js preview --config rsbuild.config.ts",
    "test": "bun test --parallel=4 src",
    "test:e2e": "bun test e2e/design-management.spec.ts",
    "test:visual": "bun test e2e/visual.test.ts && bun x reg-cli ./e2e/visual/actual ./e2e/visual/baseline ./e2e/visual/diff -R ./e2e/visual/report.html",
    "test:watch": "bun test --watch",
    "generate:icons": "bun scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dagrejs/dagre": "^3.1.0",
    "@daypilot/daypilot-lite-react": "5.10.0",
    "@gsap/react": "2.1.2",
    "@hocuspocus/provider": "4.6.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/extension-drag-handle": "3.29.2",
    "@tiptap/extension-drag-handle-react": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-node-range": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/y-tiptap": "3.0.7",
    "@xyflow/react": "12.11.5",
    "axios": "^1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.14",
    "echarts": "6.0.0",
    "fflate": "0.8.3",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "marked": "18.0.11",
    "motion": "13.2.0",
    "pinyin-match": "^1.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "yjs": "13.6.32",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@iconify-json/hugeicons": "^1.2.35",
    "@rsbuild/core": "2.2.7",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@shadcn/lint": "^0.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "oxc-parser": "^0.150.0",
    "oxc-walker": "^1.1.1",
    "oxlint": "^1.83.0",
    "playwright-core": "1.63.0",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
