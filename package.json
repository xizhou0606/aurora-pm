{
  "name": "@one-2-all/pm",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "(cd apps/web && bun run build)",
    "lint": "(cd apps/web && bun run lint)",
    "typecheck": "(cd apps/web && bun run typecheck) && (cd apps/ai-runtime && bun run typecheck)",
    "test": "(cd apps/web && bun run test)",
    "test:access-catalog": "python3 -m unittest scripts.tests.test_access_catalog_validator && python3 scripts/validate-access-catalog.py && python3 scripts/generate-access-catalog.py --check"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "@tiptap/core": "3.29.2",
    "@tiptap/pm": "3.29.2",
